# Copy this to .env and fill in your values.
# Never commit .env to git.

# ── Infrastructure ────────────────────────────────────────────────────────────
INFRA_MODE=dual_gpu

# Updated every time the Kaggle inference notebook restarts (bot has /seturl)
INFERENCE_URL=https://xxxx.ngrok-free.app

# ── Model ─────────────────────────────────────────────────────────────────────
BASE_MODEL=unsloth/Qwen3-8B-bnb-4bit

# HuggingFace: your-username/aethr-adapters
# Create a private repo at huggingface.co first, then paste the name here
HF_ADAPTER_REPO=your-hf-username/aethr-adapters
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase: Settings → Database → URI (Transaction mode, port 6543)
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=your-bot-token-from-botfather
ADMIN_USER_ID=your-telegram-numeric-user-id

# ── LLM Judge ─────────────────────────────────────────────────────────────────
# Use Anthropic (Claude) or OpenAI key here
JUDGE_API_KEY=sk-ant-xxxxxxxxxxxx
JUDGE_MODEL=claude-sonnet-4-20250514

# ── Observability ─────────────────────────────────────────────────────────────
WANDB_API_KEY=your-wandb-api-key
WANDB_PROJECT=aethr
